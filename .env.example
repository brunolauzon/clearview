# Copy to .env next to docker-compose.yml. Every value is optional.

# Header title and the address used to expand Unraid's [IP] token in WebUI links.
HOST_NAME=tower
HOST_IP=192.168.1.10

# Plex stats come from Tautulli: Settings > Web Interface > API key.
TAUTULLI_URL=http://192.168.1.10:8181
TAUTULLI_API_KEY=

# Alerts come from Grafana: Administration > Users and access > Service accounts
# > create one with the Viewer role > add token.
GRAFANA_URL=http://192.168.1.10:3000
GRAFANA_TOKEN=

# Network box: your UniFi console, with an API key from
# UniFi Network > Settings > Control Plane > Integrations.
UNIFI_URL=https://192.168.1.1
UNIFI_API_KEY=
# Site name, if you have more than one.
UNIFI_SITE=
# Consoles use a self-signed certificate. Set to 1 to accept it. This skips certificate checking for
# UniFi only, so a device on your network could impersonate the console and capture the key.
UNIFI_INSECURE=
# UniFi Protect cameras and their events show up with the settings above. Set to 0 to leave them out.
UNIFI_PROTECT=

# Torrent stats, shown in place of the alerts box while nothing is firing: the Deluge web UI.
DELUGE_URL=http://192.168.1.10:8112
DELUGE_PASSWORD=

# Where the settings you edit in the UI (clearview.yaml) are saved on the host. Must be writable.
CONFIG_DIR=/mnt/user/appdata/clearview

# Uncomment to turn off editing in the UI. Clearview has no login, so use this if it is reachable
# by anyone you do not trust.
# CONFIG_READONLY=1
