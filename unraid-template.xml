<?xml version="1.0"?>
<!--
  Unraid Docker template. Needs an image in a registry Unraid can pull from.
  Build and push one (replace YOUR_GITHUB_USER), then either:
    - save this file as /boot/config/plugins/dockerMan/templates-user/my-clearview.xml, or
    - skip it and use docker-compose.yml instead.
-->
<Container version="2">
  <Name>clearview</Name>
  <Repository>ghcr.io/YOUR_GITHUB_USER/clearview:latest</Repository>
  <Registry>https://github.com/YOUR_GITHUB_USER/clearview/pkgs/container/clearview</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Shell>sh</Shell>
  <Support>https://github.com/YOUR_GITHUB_USER/clearview/issues</Support>
  <Overview>Terminal-style dashboard: discovers your Docker containers, shows host CPU, memory and disk usage, Grafana alerts and Plex streams (via Tautulli), plus links to other devices on your network.</Overview>
  <Category>Tools: Status:Monitoring</Category>
  <WebUI>http://[IP]:[PORT:7878]/</WebUI>
  <Icon></Icon>
  <ExtraParams>--hostname=tower</ExtraParams>
  <Config Name="WebUI port" Target="7878" Default="7878" Mode="tcp" Description="Port the dashboard listens on" Type="Port" Display="always" Required="true" Mask="false">7878</Config>
  <Config Name="Docker socket" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="ro" Description="Container discovery" Type="Path" Display="always" Required="true" Mask="false">/var/run/docker.sock</Config>
  <Config Name="Array and pools" Target="/host/mnt" Default="/mnt" Mode="ro" Description="Disk usage (statfs only)" Type="Path" Display="always" Required="true" Mask="false">/mnt</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/clearview" Mode="ro" Description="Folder containing clearview.yaml (optional)" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/clearview</Config>
  <Config Name="HOST_NAME" Target="HOST_NAME" Default="tower" Mode="" Description="Name shown in the header" Type="Variable" Display="always" Required="false" Mask="false">tower</Config>
  <Config Name="HOST_IP" Target="HOST_IP" Default="" Mode="" Description="Server LAN address for WebUI links. Blank uses the address in your browser." Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="TAUTULLI_URL" Target="TAUTULLI_URL" Default="" Mode="" Description="e.g. http://192.168.1.10:8181" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="TAUTULLI_API_KEY" Target="TAUTULLI_API_KEY" Default="" Mode="" Description="Tautulli > Settings > Web Interface > API key" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="GRAFANA_URL" Target="GRAFANA_URL" Default="" Mode="" Description="e.g. http://192.168.1.10:3000" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="GRAFANA_TOKEN" Target="GRAFANA_TOKEN" Default="" Mode="" Description="Service account token with the Viewer role" Type="Variable" Display="always" Required="false" Mask="true"></Config>
</Container>
